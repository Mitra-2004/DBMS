CREATE OR REPLACE PROCEDURE calc_interest
(acc_no NUMBER, rate NUMBER)
IS
bal NUMBER;
yrs NUMBER;
interest NUMBER;
BEGIN

SELECT Balance, NoOfYears
INTO bal, yrs
FROM Account
WHERE Account_No = acc_no;

interest := (bal * rate * yrs) / 100;

INSERT INTO Earned_Interest
VALUES(acc_no, interest);

END;
/

EXEC calc_interest(101,5);


SELECT * FROM Earned_Interest;

CREATE OR REPLACE FUNCTION high_balance
RETURN SYS_REFCURSOR
IS
cur SYS_REFCURSOR;
BEGIN

OPEN cur FOR
SELECT *
FROM Account
WHERE Balance > 50000;

RETURN cur;

END;
/

VARIABLE result REFCURSOR
EXEC :result := high_balance
PRINT result




