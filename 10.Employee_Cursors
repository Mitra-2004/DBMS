CREATE TABLE Employee(
Emp_id NUMBER PRIMARY KEY,
Emp_Name VARCHAR2(50),
Salary NUMBER
);

INSERT INTO Employee VALUES(101,'Amit',60000);
INSERT INTO Employee VALUES(102,'Rahul',40000);
INSERT INTO Employee VALUES(103,'Priya',70000);
INSERT INTO Employee VALUES(104,'Neha',55000);

SELECT * FROM Employee;

SET SERVEROUTPUT ON;

DECLARE

CURSOR emp_cursor IS
SELECT *
FROM Employee
WHERE Salary > 50000;

emp_record Employee%ROWTYPE;

BEGIN

OPEN emp_cursor;

LOOP
FETCH emp_cursor INTO emp_record;

EXIT WHEN emp_cursor%NOTFOUND;

DBMS_OUTPUT.PUT_LINE(
emp_record.Emp_Name || ' ' || emp_record.Salary);

END LOOP;

CLOSE emp_cursor;

END;
/

DECLARE
total_rows NUMBER;
BEGIN

SELECT COUNT(*)
INTO total_rows
FROM Employee;

DBMS_OUTPUT.PUT_LINE('Total Employees: ' || total_rows);

END;
/

DECLARE

CURSOR emp_cursor(eid NUMBER) IS
SELECT Salary
FROM Employee
WHERE Emp_id = eid;

emp_sal NUMBER;

BEGIN

OPEN emp_cursor(101);

FETCH emp_cursor INTO emp_sal;

DBMS_OUTPUT.PUT_LINE('Salary: ' || emp_sal);

CLOSE emp_cursor;

END;
/

