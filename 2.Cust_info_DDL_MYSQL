CREATE VIEW Saving_Account AS
SELECT c.*
FROM Customer c
JOIN Account a
ON c.CustID = a.CustID
WHERE a.Account_type='Saving'
AND a.open_date='2018-08-16';

SELECT * FROM Saving_Account;

