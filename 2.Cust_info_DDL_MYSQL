CREATE VIEW Loan_Account AS
SELECT c.*
FROM Customer c
JOIN Account a
ON c.CustID = a.CustID
WHERE a.Account_type='Loan'
AND a.open_date='2018-02-16';

CREATE INDEX idx_customer
ON Customer(CustID);

CREATE INDEX idx_branch
ON Branch(Branch_ID);

