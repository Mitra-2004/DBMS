CREATE OR REPLACE FUNCTION get_manager_name
(did NUMBER)
RETURN VARCHAR2
IS
mgr_name VARCHAR2(50);
BEGIN

SELECT manager_name
INTO mgr_name
FROM Department
WHERE dept_id = did;

RETURN mgr_name;

END;
/

