CREATE OR REPLACE PROCEDURE calculate_commission
IS
BEGIN

UPDATE Employee
SET commission =
CASE
WHEN salary > 10000 THEN salary * 0.004
WHEN salary < 10000 AND (SYSDATE - DoJ)/365 > 10 THEN salary * 0.0035
WHEN salary < 3000 THEN salary * 0.0025
ELSE salary * 0.0015
END;

END;
/

EXEC calculate_commission;


SELECT emp_id, emp_name, salary, commission

