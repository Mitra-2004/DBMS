mongosh

use dbms_practical

db.createCollection("Student_Data")

db.Student_Data.insertMany([
{Student_ID:1, Student_Name:"Amit", Department:"IT", Marks:85},
{Student_ID:2, Student_Name:"Rahul", Department:"IT", Marks:75},
{Student_ID:3, Student_Name:"Priya", Department:"CS", Marks:90},
{Student_ID:4, Student_Name:"Neha", Department:"CS", Marks:80},
{Student_ID:5, Student_Name:"Riya", Department:"ENTC", Marks:70},
{Student_ID:6, Student_Name:"Aman", Department:"ENTC", Marks:95}
])

db.Student_Data.aggregate([
{
$group:{
_id:"$Department",
Average_Marks:{$avg:"$Marks"}
}
}
])

db.Student_Data.aggregate([
{
$group:{
_id:"$Department",
Total_Students:{$sum:1}
}
}
])

db.Student_Data.aggregate([
{$sort:{Department:1,Marks:-1}},
{
$group:{
_id:"$Department",
Student_Name:{$first:"$Student_Name"},
Highest_Marks:{$first:"$Marks"}
}
},
{$sort:{Highest_Marks:-1}}
])

db.Student_Data.createIndex({Student_ID:1})


db.Student_Data.createIndex({Student_Name:1,Department:1})

db.Student_Data.dropIndex({Student_ID:1})

db.Student_Data.dropIndex({Student_Name:1,Department:1})


