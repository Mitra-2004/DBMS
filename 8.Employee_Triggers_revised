CREATE OR REPLACE TRIGGER prevent_salary_decrease
BEFORE UPDATE OF salary
ON Employee
FOR EACH ROW
BEGIN
IF :NEW.salary < :OLD.salary THEN
RAISE_APPLICATION_ERROR(-20001,'Salary cannot be decreased');
END IF;
END;
/

UPDATE Employee
SET salary = 40000
WHERE emp_id = 101;

CREATE OR REPLACE TRIGGER job_change_trigger
AFTER UPDATE OF job_title
ON Employee
FOR EACH ROW
BEGIN
INSERT INTO job_history
VALUES(
:OLD.emp_id,
:OLD.job_title,
:OLD.dept_id,
:OLD.DoJ,
SYSDATE
);
END;
/

UPDATE Employee
SET job_title = 'Senior Developer'
WHERE emp_id = 101;

