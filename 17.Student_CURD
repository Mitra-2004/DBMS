mongosh

use dbms_practical

db.createCollection("Student")

db.Student.insertMany([
{Roll_No:"A1",Name:"Amit",Class:"TE",Marks:80,Address:"Pune",Enrolled_Courses:["DBMS","TOC"]},
{Roll_No:"A2",Name:"Rahul",Class:"SE",Marks:60,Address:"Mumbai",Enrolled_Courses:["DBMS","OS"]},
{Roll_No:"A3",Name:"Priya",Class:"TE",Marks:90,Address:"Pune",Enrolled_Courses:["TOC","CN"]},
{Roll_No:"A4",Name:"Neha",Class:"BE",Marks:40,Address:"Delhi",Enrolled_Courses:["DBMS"]},
{Roll_No:"A5",Name:"Riya",Class:"SE",Marks:55,Address:"Pune",Enrolled_Courses:["TOC"]},
{Roll_No:"A6",Name:"Aman",Class:"TE",Marks:70,Address:"Mumbai",Enrolled_Courses:["DBMS","CN"]},
{Roll_No:"A7",Name:"Kunal",Class:"BE",Marks:30,Address:"Pune",Enrolled_Courses:["OS"]},
{Roll_No:"A8",Name:"Anita",Class:"TE",Marks:85,Address:"Mumbai",Enrolled_Courses:["DBMS","TOC"]},
{Roll_No:"A9",Name:"Rohan",Class:"SE",Marks:65,Address:"Delhi",Enrolled_Courses:["CN"]},
{Roll_No:"A10",Name:"Sneha",Class:"TE",Marks:95,Address:"Pune",Enrolled_Courses:["DBMS","TOC","CN"]}
])

db.Student.find(
{Enrolled_Courses:{$in:["DBMS","TOC"]}},
{Name:1,_id:0}
)

db.Student.find(
{$or:[{Marks:{$gt:50}},{Class:"TE"}]},
{Roll_No:1,Class:1,_id:0}
)

db.Student.replaceOne(
{Roll_No:"A10"},
{Roll_No:"A10",Name:"Sneha",Class:"BE",Marks:88,Address:"Pune",Enrolled_Courses:["DBMS","AI"]}
)



db.Student.find()
.sort({Marks:-1})
.skip(2)
.limit(2)

db.Student.deleteMany(
{Marks:{$lt:20}}
)

db.Student.deleteOne({})

