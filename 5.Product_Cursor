sqlplus system

CREATE TABLE Products(
Product_id NUMBER PRIMARY KEY,
Product_Name VARCHAR2(50),
Product_Type VARCHAR2(50),
Price NUMBER
);

INSERT INTO Products VALUES(1,'Tshirt','Apparel',3000);
INSERT INTO Products VALUES(2,'Jeans','Apparel',6000);
INSERT INTO Products VALUES(3,'Shoes','Footwear',7000);
INSERT INTO Products VALUES(4,'Jacket','Apparel',8000);
INSERT INTO Products VALUES(5,'Cap','Apparel',1500);

SELECT * FROM Products;

SET SERVEROUTPUT ON;

DECLARE

CURSOR prod_cursor(min_price NUMBER, max_price NUMBER) IS
SELECT *
FROM Products
WHERE Price BETWEEN min_price AND max_price
AND Product_Type='Apparel';

prod_record Products%ROWTYPE;

BEGIN

OPEN prod_cursor(2000,7000);

LOOP
FETCH prod_cursor INTO prod_record;

EXIT WHEN prod_cursor%NOTFOUND;

DBMS_OUTPUT.PUT_LINE(
prod_record.Product_Name || ' ' || prod_record.Price);

END LOOP;

CLOSE prod_cursor;

END;
/

DECLARE

CURSOR prod_cursor IS
SELECT *
FROM Products
WHERE Price > 5000;

prod_record Products%ROWTYPE;

BEGIN

OPEN prod_cursor;

LOOP
FETCH prod_cursor INTO prod_record;

EXIT WHEN prod_cursor%NOTFOUND;

DBMS_OUTPUT.PUT_LINE(
prod_record.Product_Name || ' ' || prod_record.Price);

END LOOP;

CLOSE prod_cursor;

END;
/

BEGIN

UPDATE Products
SET Price = Price + 1000;

DBMS_OUTPUT.PUT_LINE('Rows Updated: ' || SQL%ROWCOUNT);

END;
/

