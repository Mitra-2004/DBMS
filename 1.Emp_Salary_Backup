CREATE TABLE Employee(
emp_id NUMBER PRIMARY KEY,
emp_name VARCHAR2(50),
salary NUMBER,
designation VARCHAR2(50)
);

CREATE TABLE Salary_Backup(
emp_id NUMBER,
old_salary NUMBER,
new_salary NUMBER,
salary_difference NUMBER
);

INSERT INTO Employee VALUES(101,'Amit',50000,'Manager');
