CREATE OR REPLACE TRIGGER salary_change_trigger
BEFORE UPDATE OF salary
ON Employee
FOR EACH ROW
BEGIN
INSERT INTO Salary_Backup
VALUES(:OLD.emp_id,
       :OLD.salary,
       :NEW.salary,
       :NEW.salary - :OLD.salary);
END;
/

UPDATE Employee
SET salary = 55000
WHERE emp_id = 101;

SELECT * FROM Salary_Backup;



CREATE OR REPLACE TRIGGER prevent_ceo_delete
BEFORE DELETE
ON Employee
FOR EACH ROW
BEGIN
IF :OLD.designation = 'CEO' THEN
RAISE_APPLICATION_ERROR(-20001,'Cannot delete CEO record');
END IF;
END;
/

DELETE FROM Employee
WHERE designation='CEO';

